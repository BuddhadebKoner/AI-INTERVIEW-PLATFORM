{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API server for Final Year Project",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"Linting backend...\"",
    "lint:fix": "echo \"Fixing lint issues...\"",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json}\" \"!node_modules/**\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json}\" \"!node_modules/**\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,json}\" \"!node_modules/**\" --log-level warn",
    "test:format": "prettier --check \"**/*.{js,mjs,cjs,json}\" \"!node_modules/**\"",
    "clean": "rm -rf node_modules",
    "precommit": "npm run format:check && npm run lint",
    "prestart": "npm run format:check"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mongoose": "^8.18.0",
    "nodemon": "^3.1.10"
  }
}
