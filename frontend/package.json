{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,html,json}\" \"*.{js,jsx,ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,html,json}\" \"*.{js,jsx,ts,tsx,css,html,json}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,html,json}\" \"*.{js,jsx,ts,tsx,css,html,json}\" --log-level warn",
    "test:format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,html,json}\" \"*.{js,jsx,ts,tsx,css,html,json}\"",
    "clean": "rm -rf dist node_modules",
    "precommit": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.43.0",
    "autoprefixer": "^10.4.21",
    "lucide-react": "^0.539.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^3.4.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^5.4.0"
  }
}
